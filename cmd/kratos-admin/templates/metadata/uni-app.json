{
  "name": "__PROJECT_NAME__-uni-app",
  "scripts": {
    "prepare:modules": "pnpm --recursive --filter './packages/modules/**' --if-present run build:entries",
    "test": "node --test",
    "build:packages": "pnpm --recursive --filter './packages/modules/**' run build",
    "check:exports": "pnpm run prepare:modules && node scripts/check-package-exports.mjs",
    "lint": "eslint . --fix"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@rushstack/eslint-patch": "^1.1.4",
    "@uni-helper/uni-app-types": "1.0.0-alpha.6",
    "@uni-helper/uni-ui-types": "1.0.0-alpha.6",
    "@vue/compiler-sfc": "3.4.21",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.8.0",
    "miniprogram-api-typings": "^4.0.5",
    "prettier": "3.6.2",
    "ts-proto": "^2.7.7",
    "turbo": "^2.10.7",
    "typescript": "5.4.5",
    "vue-tsc": "^1.8.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "core-js",
      "core-js-pure",
      "vue-demi"
    ],
    "auditConfig": {
      "ignoreCves": [
        "CVE-2024-6783"
      ]
    }
  }
}
