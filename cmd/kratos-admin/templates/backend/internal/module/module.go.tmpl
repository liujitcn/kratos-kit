package module

import (
	coremodule "github.com/liujitcn/kratos-core/module"
[[[range $index, $module := .Modules]]]
	admin[[[$index]]] "__MODULE_PATH__/internal/server/[[[$module]]]/admin/v1"
	app[[[$index]]] "__MODULE_PATH__/internal/server/[[[$module]]]/app/v1"
[[[end]]]
)

// ProjectModules 表示当前项目提供给 Core 的协议模块集合。
type ProjectModules coremodule.Modules

// NewModules 创建当前项目提供给 Core 的具名模块集合。
func NewModules(
[[[range $index, $module := .Modules]]]
	admin[[[$index]]] *admin[[[$index]]].Services,
	app[[[$index]]] *app[[[$index]]].Services,
[[[end]]]
) ProjectModules {
	return ProjectModules{
[[[range $index, $module := .Modules]]]
		admin[[[$index]]], app[[[$index]]],
[[[end]]]
	}
}
