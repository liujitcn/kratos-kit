package module

import (
	"fmt"
	"io/fs"

	coremodule "github.com/liujitcn/kratos-core/module"
	"github.com/liujitcn/kratos-kit/database/gorm"
	_const "__MODULE_PATH__/internal/const"
	"__MODULE_PATH__/internal/data"
	"__MODULE_PATH__/internal/i18n"
	"__MODULE_PATH__/internal/openapi"
	"__MODULE_PATH__/migration"
)

type resource struct {
	projectKey  string
	projectName string
	models coremodule.Models
	i18n fs.FS
	openAPI     fs.FS
	migrations coremodule.Migrations
}

// ProjectResources 表示当前项目提供给 Core 的具名静态资源集合。
type ProjectResources []coremodule.Resource

var _ coremodule.Resource = (*resource)(nil)

// NewModuleResources 创建当前项目提供给 Core 的具名资源集合。
func NewModuleResources() ProjectResources {
	return ProjectResources{
		&resource{
			projectKey:  fmt.Sprintf("%s-%s", _const.Project, _const.AppID),
			projectName: _const.Name,
			models: coremodule.Models{gorm.DefaultClientName: data.Models()},
			i18n: i18n.Assets(),
			openAPI: openapi.Assets(),
			migrations: coremodule.Migrations{
				{Name: migration.ModuleName, FS: migration.Assets(), Path: ".", Dependencies: []string{"admin"}},
			},
		},
	}
}

// ProjectKey 返回当前项目的稳定标识。
func (r *resource) ProjectKey() string {
	return r.projectKey
}

// ProjectName 返回当前项目的展示名称。
func (r *resource) ProjectName() string {
	return r.projectName
}

// Models 返回当前项目的数据库模型集合。
func (r *resource) Models() coremodule.Models {
	return r.models
}

// I18n 返回当前项目的国际化资源。
func (r *resource) I18n() fs.FS {
	return r.i18n
}

// OpenAPI 返回当前项目的 OpenAPI 资源。
func (r *resource) OpenAPI() fs.FS {
	return r.openAPI
}

// Migrations 返回当前项目的数据库迁移资源。
func (r *resource) Migrations() coremodule.Migrations {
	return r.migrations
}
