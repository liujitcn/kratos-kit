// Command server 启动当前 Admin 后端项目。
package main

import (
	"context"

	bootstrapConfigv1 "github.com/liujitcn/kratos-kit/api/gen/go/config/v1"
	"github.com/liujitcn/kratos-kit/bootstrap"
	_const "__MODULE_PATH__/internal/const"

	// 注册 MySQL 数据库驱动和 Zap 日志实现。
	_ "github.com/liujitcn/kratos-kit/database/gorm/driver/mysql"
	_ "github.com/liujitcn/kratos-kit/logger/zap"
)

const version = "1.0.0"

// main 初始化应用信息并启动服务，启动失败时终止进程。
func main() {
	ctx := bootstrap.NewContext(
		context.Background(),
		&bootstrapConfigv1.AppInfo{
			Project: _const.Project,
			AppId:   _const.AppID,
			Name:    _const.Name,
			Version: version,
		},
	)
	err := bootstrap.RunApp(ctx, NewApp)
	if err != nil {
		panic(err)
	}
}
