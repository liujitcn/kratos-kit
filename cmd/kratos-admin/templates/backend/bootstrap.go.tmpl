// Package __PACKAGE_NAME__ 提供当前项目的 Core、Admin 和业务模块依赖注入集合。
package __PACKAGE_NAME__

import (
	"github.com/google/wire"
	adminbackend "github.com/liujitcn/kratos-admin/backend"
	kratoscore "github.com/liujitcn/kratos-core"
	corejob "github.com/liujitcn/kratos-core/job"
	coremodule "github.com/liujitcn/kratos-core/module"
	corequeue "github.com/liujitcn/kratos-core/queue"
	coresse "github.com/liujitcn/kratos-core/sse"
	projectModule "__MODULE_PATH__/internal/module"
)

// ProviderSet 提供当前项目独立应用所需的 Core、Admin 和业务模块依赖。
var ProviderSet = wire.NewSet(
	kratoscore.ProviderSet,
	adminbackend.ProviderSet,
	hostProviderSet,
)

// hostProviderSet 将当前项目业务模块与 Admin 的具名贡献合并为 Core 集合。
var hostProviderSet = wire.NewSet(
	projectModule.NewModuleResources,
	projectModule.NewModules,
	ProvideResources,
	ProvideModules,
	ProvideTasks,
	ProvideStreams,
	ProvideConsumers,
)

// ProvideResources 合并 Admin 和当前项目的静态资源。
func ProvideResources(
	adminResources adminbackend.AdminResources,
	projectResources projectModule.ProjectResources,
) coremodule.Resources {
	resources := make(coremodule.Resources, 0, len(adminResources)+len(projectResources))
	resources = append(resources, coremodule.Resources(adminResources)...)
	resources = append(resources, projectResources...)
	return resources
}

// ProvideModules 合并 Admin 和当前项目的协议模块。
func ProvideModules(
	adminModules adminbackend.AdminModules,
	projectModules projectModule.ProjectModules,
) coremodule.Modules {
	modules := make(coremodule.Modules, 0, len(adminModules)+len(projectModules))
	modules = append(modules, coremodule.Modules(adminModules)...)
	modules = append(modules, projectModules...)
	return modules
}

// ProvideTasks 将 Admin 定时任务转换为 Core 任务集合。
func ProvideTasks(adminTasks adminbackend.AdminTasks) corejob.Tasks {
	return corejob.Tasks(adminTasks)
}

// ProvideStreams 将 Admin SSE 流转换为 Core 流集合。
func ProvideStreams(adminStreams adminbackend.AdminStreams) coresse.Streams {
	return coresse.Streams(adminStreams)
}

// ProvideConsumers 将 Admin 队列消费者转换为 Core 消费者集合。
func ProvideConsumers(adminConsumers adminbackend.AdminConsumers) corequeue.Consumers {
	return corequeue.Consumers(adminConsumers)
}
