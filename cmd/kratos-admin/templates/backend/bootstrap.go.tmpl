// ProviderSet 提供当前项目的最小 Core 应用依赖注入集合。
var ProviderSet = wire.NewSet(
	kratoscore.NewApp,
	configProviderSet,
	bizProviderSet,
	coremodule.ProviderSet,
	coredata.ProviderSet,
	coreDocs.ProviderSet,
	coreI18n.ProviderSet,
	coreMigration.ProviderSet,
	coreOpenAPI.ProviderSet,
	coremcp.ProviderSet,
	coreSSE.ProviderSet,
	coreServer.ProviderSet,
	projectModule.NewModuleResources,
	projectModule.NewModules,
	NewStreams,
	NewSyncResult,
	NewQueueServer,
	NewJobServer,
)

var configProviderSet = wire.NewSet(
	coreconfig.ParseBootstrap,
	coreconfig.ParseAppInfo,
	coreconfig.ParseDatabase,
	coreconfig.ParseQueue,
	coreconfig.ParsePprof,
	coreconfig.ParseOSS,
	coreconfig.ParseAuthnJWT,
	coreconfig.ParseTranslator,
)

var bizProviderSet = wire.NewSet(
	corebiz.NewAuthenticator,
	corebiz.NewAuthzEngine,
	corebiz.NewUserToken,
	corebiz.NewBaseCase,
	kitPprof.NewPprof,
	kitOSS.NewOSS,
	kitTranslator.NewTranslator,
	NewMemoryCache,
	NewMemoryQueue,
)

// NewMemoryCache 创建不依赖外部 Redis 的内存缓存。
func NewMemoryCache() (kitCache.Cache, func(), error) {
	return cacheMemory.NewMemory()
}

// NewMemoryQueue 创建不依赖外部 Redis 的内存队列。
func NewMemoryQueue(config *bootstrapConfigv1.Data_Queue) (kitQueue.Queue, func(), error) {
	return kitQueue.NewQueue(nil, config)
}

// NewSyncResult 提供最小服务所需的空资源同步结果。
func NewSyncResult() *coreresource.SyncResult {
	return &coreresource.SyncResult{}
}

// NewStreams 提供最小服务的空 SSE 流集合。
func NewStreams() coreSSE.Streams {
	return nil
}

// NewQueueServer 禁用未注册消费者的独立队列服务。
func NewQueueServer() *corequeue.Server {
	return nil
}

// NewJobServer 禁用未注册任务的独立定时任务服务。
func NewJobServer() *corejob.Server {
	return nil
}
