func {{.RegisterName}}(mcpServer *{{$.MCPServer}}, {{.ServerName}} {{.ServiceName}}Server) {
	mcpServer.AddTool(
		{{$.NewTool}}({{.ToolName}},
			{{$.WithDescription}}({{.Description}}),
{{if not .RecursiveInput}}			{{$.WithInputSchema}}[*{{.RequestType}}](),
{{end}}{{if not .RecursiveOutput}}			{{$.WithOutputSchema}}[*{{.ResponseType}}](),
{{end}}		),
		func(ctx {{$.ContextPackage}}, request {{$.CallToolRequest}}) (*{{$.CallToolResult}}, error) {
			req := &{{.RequestType}}{}
			err := request.BindArguments(req)
			if err != nil {
				return nil, err
			}
			var reply *{{.ResponseType}}
			reply, err = {{.ServerName}}.{{.Name}}(ctx, req)
			if err != nil {
				return {{$.NewToolResultError}}(err.Error()), nil
			}
			return {{$.NewToolResultJSON}}(reply)
		},
	)
}

