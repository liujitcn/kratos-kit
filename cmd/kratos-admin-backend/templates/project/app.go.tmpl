// Package project 提供当前后端项目的模块和独立应用组合入口。
package project

import (
	"github.com/go-kratos/kratos/v3"
	"github.com/google/wire"
	"github.com/liujitcn/kratos-admin/backend/core"
	bootstrapConfigv1 "github.com/liujitcn/kratos-kit/api/gen/go/config/v1"
	"github.com/liujitcn/kratos-kit/bootstrap"
	databaseGorm "github.com/liujitcn/kratos-kit/database/gorm"
	gormmigration "github.com/liujitcn/kratos-kit/database/gorm/migration"

	"__MODULE_PATH__/internal/biz"
	systemConfig "__MODULE_PATH__/internal/config"
	"__MODULE_PATH__/internal/data"
	internalprojectdocs "__MODULE_PATH__/internal/projectdocs"
	"__MODULE_PATH__/internal/server"
	"__MODULE_PATH__/internal/service"
	"__MODULE_PATH__/projectdoc"
)

// AdditionalModules 表示与当前项目一起装配的扩展模块集合。
type AdditionalModules []core.Module

// Option 配置当前项目的模块和独立应用装配。
type Option func(*options)

type options struct {
	additionalModules          AdditionalModules
	configuredProjectDocuments projectdoc.ConfiguredDocuments
	databaseOptions            []databaseGorm.ClientOption
	migrations                 gormmigration.AdditionalMigrations
}

// Runtime 封装当前项目的服务注册和运行时贡献。
type Runtime struct {
	// Modules 汇总当前项目模块与调用方追加的扩展模块。
	core.Modules
	projectDocuments []projectdoc.Document
}

var (
	_ core.Module            = (*Runtime)(nil)
	_ projectdoc.Contributor = (*Runtime)(nil)
)

// WithAdditionalModules 追加由同一启动器挂载的扩展模块。
func WithAdditionalModules(modules ...core.Module) Option {
	return func(opts *options) {
		opts.additionalModules = append(opts.additionalModules, modules...)
	}
}

// WithProjectDocuments 追加由宿主项目直接提供的文档。
func WithProjectDocuments(documents ...projectdoc.Document) Option {
	return func(opts *options) {
		opts.configuredProjectDocuments = append(opts.configuredProjectDocuments, documents...)
	}
}

// WithDatabaseOptions 追加数据库客户端配置，供数据层扩展后使用。
func WithDatabaseOptions(values ...databaseGorm.ClientOption) Option {
	return func(opts *options) {
		opts.databaseOptions = append(opts.databaseOptions, values...)
	}
}

// WithMigrations 追加数据库迁移贡献者，供数据层扩展后使用。
func WithMigrations(contributors ...gormmigration.Contributor) Option {
	return func(opts *options) {
		opts.migrations = append(opts.migrations, contributors...)
	}
}

// NewModule 创建可挂载到其他 Core 宿主的当前项目模块。
func NewModule(ctx *bootstrap.Context, optionValues ...Option) (*Runtime, func(), error) {
	opts := newOptions(optionValues)
	return initModule(
		ctx,
		opts.additionalModules,
		opts.configuredProjectDocuments,
		opts.databaseOptions,
		opts.migrations,
	)
}

// NewApp 创建当前项目的独立 Kratos 应用。
func NewApp(ctx *bootstrap.Context, optionValues ...Option) (*kratos.App, func(), error) {
	opts := newOptions(optionValues)
	return initApp(
		ctx,
		opts.additionalModules,
		opts.configuredProjectDocuments,
		opts.databaseOptions,
		opts.migrations,
	)
}

// ProjectDocuments 返回当前项目及扩展模块贡献的项目文档。
func (r *Runtime) ProjectDocuments() []projectdoc.Document {
	return append([]projectdoc.Document(nil), r.projectDocuments...)
}

// newOptions 汇总调用方提供的项目装配选项。
func newOptions(optionValues []Option) options {
	opts := options{}
	for _, option := range optionValues {
		option(&opts)
	}
	return opts
}

// newRuntime 汇总当前项目模块、扩展模块和项目文档。
func newRuntime(
	appInfo *bootstrapConfigv1.AppInfo,
	module *server.Module,
	additionalModules AdditionalModules,
	configuredDocuments projectdoc.ConfiguredDocuments,
	_ []databaseGorm.ClientOption,
	_ gormmigration.AdditionalMigrations,
) (*Runtime, func(), error) {
	documents, err := internalprojectdocs.Documents(
		appInfo.GetProject(),
		appInfo.GetName(),
	)
	if err != nil {
		return nil, nil, err
	}
	documents = append(documents, configuredDocuments...)
	for _, additionalModule := range additionalModules {
		contributor, ok := additionalModule.(projectdoc.Contributor)
		if !ok {
			continue
		}
		documents = append(documents, contributor.ProjectDocuments()...)
	}
	modules := make(core.Modules, 0, len(additionalModules)+1)
	modules = append(modules, module)
	modules = append(modules, additionalModules...)
	runtime := &Runtime{
		Modules:          modules,
		projectDocuments: documents,
	}
	return runtime, func() {}, nil
}

// newApp 使用 Core 宿主创建当前项目的独立应用。
func newApp(ctx *bootstrap.Context, runtime *Runtime) (*kratos.App, func(), error) {
	return core.NewApp(ctx, core.WithModules(runtime))
}

var moduleProviderSet = wire.NewSet(
	biz.ProviderSet,
	systemConfig.ProviderSet,
	data.ProviderSet,
	service.ProviderSet,
	server.ProviderSet,
	newRuntime,
)

var appProviderSet = wire.NewSet(
	moduleProviderSet,
	newApp,
)
