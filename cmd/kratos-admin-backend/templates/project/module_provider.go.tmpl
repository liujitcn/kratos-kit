package __PACKAGE_NAME__

import (
	"fmt"

	"github.com/google/wire"
	"github.com/liujitcn/kratos-admin/backend/core"
	coreProjectDoc "github.com/liujitcn/kratos-admin/backend/core/pkg/projectdoc"
	bootstrapConfigv1 "github.com/liujitcn/kratos-kit/api/gen/go/config/v1"

	"__MODULE_PATH__/internal/biz"
	systemConfig "__MODULE_PATH__/internal/config"
	"__MODULE_PATH__/internal/data"
	"__MODULE_PATH__/internal/docs"
	"__MODULE_PATH__/internal/server"
	"__MODULE_PATH__/internal/service"
)

// newAdditionalProjectDocuments 汇总宿主配置与外部模块贡献的项目文档。
func newAdditionalProjectDocuments(
	modules AdditionalModules,
	configuredDocuments coreProjectDoc.ConfiguredDocuments,
) coreProjectDoc.AdditionalDocuments {
	documents := append(coreProjectDoc.AdditionalDocuments(nil), configuredDocuments...)
	documents = append(documents, core.Modules(modules).ProjectDocuments()...)
	return documents
}

// newProjectDocumentCatalog 合并当前项目内置目录与外部模块贡献的项目文档。
func newProjectDocumentCatalog(
	appInfo *bootstrapConfigv1.AppInfo,
	additionalDocuments coreProjectDoc.AdditionalDocuments,
) (*coreProjectDoc.Catalog, error) {
	embeddedCatalog, err := coreProjectDoc.ParseCatalog(
		docs.DocsData,
		appInfo.GetProject(),
		appInfo.GetName(),
	)
	if err != nil {
		return nil, fmt.Errorf("加载内置项目文档目录: %w", err)
	}
	documents := embeddedCatalog.Documents()
	documents = append(documents, additionalDocuments...)
	return coreProjectDoc.NewCatalog(documents...)
}

// NewRuntime 创建当前项目运行时并装载构建期项目文档。
func NewRuntime(
	module *server.Module,
	catalog *coreProjectDoc.Catalog,
) *Runtime {
	return &Runtime{
		Modules:          core.Modules{module},
		projectDocuments: catalog.Documents(),
	}
}

// moduleProviderSet 汇总当前项目模块的分层依赖注入提供者。
var moduleProviderSet = wire.NewSet(
	biz.ProviderSet,
	systemConfig.ProviderSet,
	data.ProviderSet,
	service.ProviderSet,
	server.ProviderSet,
	newAdditionalProjectDocuments,
	newProjectDocumentCatalog,
	NewRuntime,
)
