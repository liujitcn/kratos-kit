// Package projectdocs 装载构建期生成的项目文档目录。
package projectdocs

import (
	"encoding/json"
	"fmt"
	"sort"

	"__MODULE_PATH__/projectdoc"
)

type catalog struct {
	Documents   []catalogDocument  `json:"documents"`
	Directories []catalogDirectory `json:"directories"`
}

type catalogDocument struct {
	Path      string `json:"path"`
	Content   string `json:"content"`
	UpdatedAt string `json:"updated_at"`
}

type catalogDirectory struct {
	Documents   []catalogDocument  `json:"documents"`
	Directories []catalogDirectory `json:"directories"`
}

// Documents 使用运行时项目信息解析构建期内嵌的项目文档。
func Documents(projectKey, projectName string) ([]projectdoc.Document, error) {
	var value catalog
	var err error
	err = json.Unmarshal(DocsData, &value)
	if err != nil {
		return nil, fmt.Errorf("解析项目文档目录: %w", err)
	}
	documents := make([]projectdoc.Document, 0)
	documents = appendDocuments(documents, value.Documents, projectKey, projectName)
	documents = appendDirectoryDocuments(documents, value.Directories, projectKey, projectName)
	sort.Slice(documents, func(left, right int) bool {
		return documents[left].Path < documents[right].Path
	})
	return documents, nil
}

// appendDirectoryDocuments 递归展开目录树中的项目文档。
func appendDirectoryDocuments(
	documents []projectdoc.Document,
	directories []catalogDirectory,
	projectKey string,
	projectName string,
) []projectdoc.Document {
	for _, directory := range directories {
		documents = appendDocuments(documents, directory.Documents, projectKey, projectName)
		documents = appendDirectoryDocuments(
			documents,
			directory.Directories,
			projectKey,
			projectName,
		)
	}
	return documents
}

// appendDocuments 使用运行时项目信息转换并追加构建期文档。
func appendDocuments(
	documents []projectdoc.Document,
	values []catalogDocument,
	projectKey string,
	projectName string,
) []projectdoc.Document {
	for _, value := range values {
		documents = append(
			documents,
			projectdoc.NewDocument(
				projectKey,
				projectName,
				value.Path,
				value.Content,
				value.UpdatedAt,
			),
		)
	}
	return documents
}
